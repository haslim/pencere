TYPE=TRIGGERS
triggers='CREATE DEFINER=`root`@`localhost` TRIGGER dbpoz_before_ins_tr1 BEFORE INSERT ON dbpoz FOR EACH ROW\nBEGIN\nDECLARE POZADET INT default 0;\nSelect count(RENK) INTO POZADET from dbpoz where siparisno=new.siparisno;\nupdate dbsiparis set dbsiparis.pozsayac =POZADET, dbsiparis.adet = dbsiparis.adet +  new.adet ,dbsiparis.kayitmtul = dbsiparis.kayitmtul +  new.kayitmtul ,dbsiparis.kanatmtul = dbsiparis.kanatmtul +  new.kanatmtul ,dbsiparis.kasamtul = dbsiparis.kasamtul +  new.kasamtul ,dbsiparis.mtul = dbsiparis.mtul +  new.mtul , dbsiparis.cerceve = dbsiparis.cerceve +  new.cerceve where dbsiparis.SIPARISNO = new.siparisno;\nEND' 'CREATE DEFINER=`root`@`localhost` TRIGGER dbpoz_after_upd_tr1 AFTER UPDATE ON dbpoz FOR EACH ROW\nBEGIN\nDECLARE POZADET INT default 0;\nSelect count(RENK) INTO POZADET from dbpoz where siparisno=old.siparisno;\nif old.mtul <> new.mtul then\nupdate dbsiparis set dbsiparis.pozsayac =POZADET, dbsiparis.adet = (dbsiparis.adet - old.adet ) +  new.adet ,dbsiparis.kayitmtul = (dbsiparis.kayitmtul - old.kayitmtul ) +  new.kayitmtul ,dbsiparis.kanatmtul = (dbsiparis.kanatmtul - old.kanatmtul ) +  new.kanatmtul ,dbsiparis.kasamtul = (dbsiparis.kasamtul - old.kasamtul ) +  new.kasamtul , dbsiparis.mtul = (dbsiparis.mtul - old.mtul ) +  new.mtul , dbsiparis.cerceve = (dbsiparis.cerceve - old.cerceve ) +  new.cerceve where dbsiparis.SIPARISNO = new.siparisno;\nend if;\nif OLD.mtul = 0 then\nupdate dbsiparis set dbsiparis.pozsayac =POZADET, dbsiparis.adet = dbsiparis.adet +  new.adet ,dbsiparis.kayitmtul = dbsiparis.kayitmtul +  new.kayitmtul ,dbsiparis.kanatmtul = dbsiparis.kanatmtul +  new.kanatmtul ,dbsiparis.kasamtul = dbsiparis.kasamtul +  new.kasamtul ,dbsiparis.mtul = dbsiparis.mtul +  new.mtul , dbsiparis.cerceve = dbsiparis.cerceve +  new.cerceve where dbsiparis.SIPARISNO = new.siparisno;\nend if;\nEND' 'CREATE DEFINER=`root`@`localhost` TRIGGER dbpoz_before_del_tr1 BEFORE DELETE ON dbpoz FOR EACH ROW\nBEGIN\nDECLARE POZADET INT default 0;\nSelect count(RENK) INTO POZADET from dbpoz where siparisno=old.siparisno;\nupdate dbsiparis set dbsiparis.pozsayac =POZADET, dbsiparis.adet = dbsiparis.adet - old.adet ,dbsiparis.kayitmtul = dbsiparis.kayitmtul - old.kayitmtul ,dbsiparis.kanatmtul = dbsiparis.kanatmtul - old.kanatmtul ,dbsiparis.kasamtul = dbsiparis.kasamtul - old.kasamtul ,dbsiparis.mtul = dbsiparis.mtul - old.mtul , dbsiparis.cerceve = dbsiparis.cerceve - old.cerceve where dbsiparis.SIPARISNO = old.siparisno;\nEND'
