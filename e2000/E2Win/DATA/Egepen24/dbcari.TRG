TYPE=TRIGGERS
triggers='CREATE DEFINER=`root`@`localhost` TRIGGER dbcari_after_upd AFTER UPDATE ON dbcari FOR EACH ROW\nBEGIN\nif old.kod <> new.kod then\nUPDATE dbirsaliye set dbirsaliye.kod = new.kod where dbirsaliye.kod = old.kod;\nUPDATE dboptliste set dboptliste.carikod = new.kod where dboptliste.carikod = old.kod;\nUPDATE dbsiparis set dbsiparis.carikod = new.kod where dbsiparis.carikod = old.kod;\nUPDATE dbstokh set dbstokh.carikodu = new.kod where dbstokh.carikodu = old.kod;\nUPDATE dbteklif set dbteklif.carikod = new.kod where dbteklif.carikod = old.kod;\nUPDATE dbtesdetay set dbtesdetay.carikod = new.kod where dbtesdetay.carikod = old.kod;\nUPDATE siparis set siparis.carikod = new.kod where siparis.carikod = old.kod;\n\n\nIF EXISTS (SELECT SCHEMA_NAME FROM INFORMATION_SCHEMA.SCHEMATA WHERE SCHEMA_NAME = N\'uretim\') then\nupdate uretim.planlama  set uretim.planlama.carikod = new.kod where uretim.planlama.carikod=old.kod and  uretim.planlama.dbname = (SELECT DATABASE() as dataname FROM dual); \nupdate uretim.kesimdata  set uretim.kesimdata.carikod = new.kod where uretim.kesimdata.carikod=old.kod and  uretim.kesimdata.dbname = (SELECT DATABASE() as dataname FROM dual); \nend if;\n\n\nIF EXISTS (SELECT SCHEMA_NAME FROM INFORMATION_SCHEMA.SCHEMATA WHERE SCHEMA_NAME = N\'muhasebe\') then\nupdate muhasebe.satis  set muhasebe.satis.carikodu = new.kod where muhasebe.satis.carikodu=old.kod and  muhasebe.satis.dbname = (SELECT DATABASE() as dataname FROM dual); \nupdate muhasebe.satisp  set muhasebe.satisp.carikodu = new.kod where muhasebe.satisp.carikodu=old.kod and  muhasebe.satisp.dbname = (SELECT DATABASE() as dataname FROM dual); \nupdate muhasebe.stokkontrol  set muhasebe.stokkontrol.carikodu = new.kod where muhasebe.stokkontrol.carikodu=old.kod and  muhasebe.stokkontrol.dbname = (SELECT DATABASE() as dataname FROM dual); \nupdate muhasebe.uretimrecete  set muhasebe.uretimrecete.carikodu = new.kod where muhasebe.uretimrecete.carikodu=old.kod and  muhasebe.uretimrecete.dbname = (SELECT DATABASE() as dataname FROM dual); \nupdate muhasebe.cari  set muhasebe.cari.carikod = new.kod where muhasebe.cari.carikod=old.kod; \nupdate muhasebe.sevkiyatdetay  set muhasebe.sevkiyatdetay.carikod = new.kod where muhasebe.sevkiyatdetay.carikod=old.kod; \nend if;\n\nend if;\n\nif old.adi <> new.adi then\nUPDATE dbirsaliye set dbirsaliye.cariunv = new.adi where dbirsaliye.cariunv = old.adi;\nUPDATE dbsiparis set dbsiparis.cariunvan = new.adi where dbsiparis.cariunvan = old.adi;\nUPDATE dbteklif set dbteklif.cariunvan = new.adi where dbteklif.cariunvan = old.adi;\nUPDATE siparis set siparis.cariunvan = new.adi where siparis.cariunvan = old.adi;\nend if;\n\nEND'
sql_modes=1344274432
definers='root@localhost'
client_cs_names='latin5'
connection_cl_names='latin5_turkish_ci'
db_cl_names='utf8_general_ci'
created=174117083388
